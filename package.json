{
  "name": "static-blog-starter",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "npm run lint:content && npm run build && npm run qa",
    "lint:content": "node scripts/lint-content.mjs",
    "new:post": "node scripts/new-entry.mjs blog",
    "new:case-study": "node scripts/new-entry.mjs case-studies",
    "posts:index": "node scripts/posts-index.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "import:wordpress": "node scripts/import-wordpress.mjs",
    "featured-image": "node scripts/make-featured-image.mjs",
    "new:service": "node scripts/new-entry.mjs services",
    "new:location": "node scripts/new-entry.mjs locations",
    "qa": "node scripts/qa-site.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.5",
    "gray-matter": "^4.0.3",
    "sharp": "^0.35.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "fast-xml-parser": "^5.11.2",
    "pagefind": "^1.6.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
