import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/blog/Breadcrumbs.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { getServices, serviceUrl } from '../../lib/content';
import { breadcrumbSchema } from '../../lib/schema';
import { site } from '../../site.config';

const services = await getServices();
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Services', url: '/services/' }];
const a = site.business.address;
---

<BaseLayout
  metaTitle={`Services in ${a.city}, ${a.region}`}
  metaDescription={`Explore every service ${site.name} offers in ${a.city}, ${a.region} and nearby areas. Upfront pricing and free estimates.`}
  schema={[
    breadcrumbSchema(crumbs),
    { '@type': 'ItemList', itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.data.serviceName, url: serviceUrl(s) })) },
  ]}
>
  <section class="container page-hero">
    <Breadcrumbs items={crumbs} />
    <h1>Our Services</h1>
    <p class="muted">Everything we do, in one place.</p>
  </section>
  <section class="container">
    <div class="post-grid">
      {services.map((s) => (
        <PostCard href={serviceUrl(s)} title={s.data.serviceName} excerpt={s.data.excerpt} image={s.data.featuredImage} imageAlt={s.data.featuredImageAlt} date={s.data.publishDate} showDate={false} />
      ))}
    </div>
  </section>
</BaseLayout>
