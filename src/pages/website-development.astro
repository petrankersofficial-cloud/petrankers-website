---
import BaseLayout from '../layouts/BaseLayout.astro';
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Website design and development for pet businesses",
    "serviceType": "Website development",
    "provider": {
      "@type": "Organization",
      "name": "Pet Rankers",
      "url": "https://petrankers.com/"
    },
    "url": "https://petrankers.com/website-development/",
    "description": "Free website design for pet businesses. Pay only for development: a conversion-focused 5-page website for $800 with one year of free support, or custom pricing for more.",
    "offers": [
      {
        "@type": "Offer",
        "name": "Standard website",
        "price": "800",
        "priceCurrency": "USD",
        "description": "Up to 5 pages, free design, one year of free support"
      },
      {
        "@type": "Offer",
        "name": "Custom website",
        "description": "Custom pricing for additional pages, extra functionality, CRM integration or a custom CMS"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is the website design really free?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. We design your website for free and only charge for development."
        }
      },
      {
        "@type": "Question",
        "name": "What is included in the $800 standard website?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Up to 5 pages, a free website design, a conversion-focused build around good UX, and one year of free support."
        }
      },
      {
        "@type": "Question",
        "name": "Which pages does a standard website include?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Up to 5 pages, the typical page count for a standard small business website, such as Home, About, Services, Gallery or Reviews, and Contact."
        }
      },
      {
        "@type": "Question",
        "name": "What if I need more than 5 pages or extra features?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We offer custom pricing for clients who want more from their website. This covers things like additional pages, extra functionality, CRM integration, a custom CMS, or any other features beyond the standard package."
        }
      },
      {
        "@type": "Question",
        "name": "What does the one year of free support cover?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "If the website has any issues during that time, we’ll fix them."
        }
      }
    ]
  }
];
---

<BaseLayout
  metaTitle={"Website Design & Development for Pet Businesses | Pet Rankers"}
  exactTitle
  metaDescription={"Free website design for pet businesses. Pay only for development: a conversion-focused 5-page website for $800 with one year of free support, or custom pricing for more."}
  canonical={"https://petrankers.com/website-development/"}
  ogImage={"https://petrankers.com/images/pet-business-seo-agency-google-maps-bookings.webp"}
  ogImageAlt={"Pet Rankers, the SEO agency for pet businesses, with a phone showing a \"dog groomer near me\" Google Maps search."}
  schema={schemas}
>
  <section class="pr-sec pr-hero pr-grain pr-shero" aria-labelledby="hero-h">
    <svg class="pr-streaks" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><g fill="none" stroke="#fff" stroke-linecap="round"><path d="M-80 700C260 520 520 760 860 520S1240 120 1560 220" stroke-opacity=".22" stroke-width="2"/><path d="M-80 760C280 590 540 820 880 590S1260 190 1560 290" stroke-opacity=".14" stroke-width="2"/><path d="M-80 640C240 450 500 700 840 450S1220 50 1560 150" stroke-opacity=".12" stroke-width="1.5"/><path d="M700 -40C820 160 1060 120 1180 340S1300 700 1500 760" stroke-opacity=".18" stroke-width="2"/></g></svg>
    <div class="pr-glow pr-glow--light" style="width:720px;height:720px;right:-120px;top:-160px" aria-hidden="true"></div>
    <div class="pr-glow pr-glow--deep" style="width:640px;height:640px;left:-260px;bottom:-260px;animation-delay:-9s" aria-hidden="true"></div>
    <div class="pr-wrap pr-hero__grid">
      <div class="pr-hero__copy">
        <div class="pr-shero__chips" data-reveal><span>Free website design</span><span>Pay only for development</span></div>
        <h1 class="pr-h1" id="hero-h" data-reveal style="--d:1;text-wrap:balance">Websites for pet&nbsp;businesses, <span class="pr-mark">designed&nbsp;free</span></h1>
        <p class="pr-lead" data-reveal style="--d:2">We design your website for free and only charge for development. Every website is conversion-focused and built around good UX, with one year of free support.</p>
        <div class="pr-actions" data-reveal style="--d:3"><a class="pr-btn pr-btn--navy" href="/contact/">Schedule An Intro Call<span class="pr-btn__arr" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 12h12M13 7l5 5-5 5"/></svg></span></a><a class="pr-btn pr-btn--outline" href="#web-pricing">See pricing</a></div>
      </div>
      <div class="pr-shero__media wd-hero" data-reveal style="--d:2">
        <div class="wd-mock" role="img" aria-label="A pet business website shown on a laptop browser and a phone, with a Book now button">
          <div class="wd-br">
            <div class="wd-br__bar"><s></s><s></s><s></s><span>yourpetbusiness.com</span></div>
            <div class="wd-br__nav"><b>Your Studio</b><i></i><i></i><i></i><u>Book now</u></div>
            <div class="wd-br__hero"><div><i class="lg" style="width:92%"></i><i class="lg" style="width:64%"></i><i style="width:82%"></i><i style="width:58%"></i><div class="wd-br__btns"><u>Book now</u><u class="o">Services</u></div></div><span class="wd-br__img"></span></div>
            <div class="wd-br__cards"><span><em></em><i></i><i style="width:60%"></i></span><span><em></em><i></i><i style="width:70%"></i></span><span><em></em><i></i><i style="width:50%"></i></span></div>
            <span class="wd-cur" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 3l15 6-6.5 2L10 18z"/></svg></span>
          </div>
          <div class="wd-ph"><span class="wd-ph__isl"></span><div class="wd-ph__nav"><b>Your Studio</b><i></i></div><span class="wd-ph__img"></span><i class="lg" style="width:86%"></i><i style="width:70%"></i><i style="width:52%"></i><u>Book now</u></div>
          <span class="wd-tag wd-tag--a"><b>$0</b> design</span>
          <span class="wd-tag wd-tag--b"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.6-3 8.4-7 10-4-1.6-7-5.4-7-10V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>1 year free support</span>
        </div>
      </div>
    </div>
  </section>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><symbol id="pr-ast" viewBox="0 0 24 24"><path d="M12 2v20M3.3 7l17.4 10M3.3 17L20.7 7" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round"/></symbol></svg>
  <div class="pr-ribbon-wrap" aria-label="Who we serve">
    <div class="pr-ribbon">
      <div class="pr-ribbon__track">
        <ul class="pr-ribbon__set"><li>PET GROOMERS<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>DOG TRAINERS<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>PET SITTERS<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>VETERINARY CLINICS<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>PET BOARDING<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>DOGGY DAYCARE<svg class="pr-ast"><use href="#pr-ast"/></svg></li></ul>
        <ul class="pr-ribbon__set" aria-hidden="true"><li>PET GROOMERS<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>DOG TRAINERS<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>PET SITTERS<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>VETERINARY CLINICS<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>PET BOARDING<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>DOGGY DAYCARE<svg class="pr-ast"><use href="#pr-ast"/></svg></li></ul>
      </div>
    </div>
  </div>
  
  
  
  <section class="pr-sec pr-sec--cream pr-orn2 wd-inc" aria-labelledby="inc-h">
