    <div class="pr-wrap">
      <div class="pr-head pr-head--center">
        <span class="pr-eyebrow" data-reveal>Pricing</span>
        <h2 class="pr-h2" id="wp-h" data-reveal style="--d:1">Free design. <em class="hl">Pay only for development.</em></h2>
      </div>
      <div class="pr-plans pr-plans--two">
        <article class="pr-plan is-best" data-reveal data-spot><span class="pr-plan__pop">Design free</span>
          <span class="pr-plan__name">Standard website</span>
          <div class="pr-plan__price"><b>$800</b><small>one-time</small></div>
          <a class="pr-btn pr-btn--primary" href="/contact/">Get Started Now<span class="pr-btn__arr" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 12h12M13 7l5 5-5 5"/></svg></span></a>
          <ul class="pr-checks"><li>Website design included free</li><li>Up to 5 pages: Home, About, Services, Gallery or Reviews, and Contact</li><li>Conversion-focused build</li><li>Built around good UX</li><li>One year of free support</li></ul>
        </article>
        <article class="pr-plan pr-plan--multi wd-custom" data-reveal data-spot>
          <span class="pr-plan__name">Custom website</span>
          <div class="pr-plan__price"><b>Custom</b><small>pricing</small></div>
          <p>For clients who want more from their website.</p>
          <ul class="pr-plan__fors"><li>Additional pages</li><li>Extra functionality</li><li>CRM integration</li><li>A custom CMS</li><li>Any other features beyond the standard package</li></ul>
          <a class="pr-btn pr-btn--light" href="/contact/">Get a Custom Quote<span class="pr-btn__arr" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 12h12M13 7l5 5-5 5"/></svg></span></a>
        </article>
      </div>
    </div>
  </section>
  
  <section class="pr-sec pr-sec--cream" aria-labelledby="faq-h">
    <div class="pr-faq-orn" aria-hidden="true">
      <svg class="pr-orn2__lines" viewBox="0 0 1440 700" preserveAspectRatio="none" aria-hidden="true"><g fill="none" stroke="#FF6A00" stroke-linecap="round"><path d="M-80 560C260 380 520 620 860 400S1240 40 1560 160" stroke-opacity=".28" stroke-width="2"/><path d="M-80 640C280 460 540 700 880 480S1260 120 1560 240" stroke-opacity=".16" stroke-width="2"/><path d="M-80 480C240 300 500 540 840 320S1220 -40 1560 80" stroke-opacity=".12" stroke-width="1.5"/></g></svg>
      <span class="pr-orn2__dots"></span>
      <div class="pr-glow pr-glow--orange" style="width:520px;height:520px;right:-220px;top:-200px;opacity:.4"></div>
      <div class="pr-glow pr-glow--soft" style="width:480px;height:480px;left:-200px;bottom:-220px;animation-delay:-10s"></div>
      <span class="pr-ix-rings pr-faq-rings"><i></i><i></i><i></i></span>
      <div class="pr-badge-spin pr-badge-spin--sec pr-badge-spin--cream" aria-hidden="true"><svg viewBox="0 0 120 120" class="pr-badge-spin__ring"><defs><path id="pr-sc5" d="M60 60m-45 0a45 45 0 1 1 90 0a45 45 0 1 1-90 0"/></defs><circle cx="60" cy="60" r="60" fill="#0F1B33"/><text fill="#fff" font-size="9.5" font-weight="600"><textPath href="#pr-sc5" textLength="280" lengthAdjust="spacing">SEARCH VOLUME ✱ EVERY MONTH ✱ EVERY CITY ✱ </textPath></text></svg><span class="pr-badge-spin__core"><svg viewBox="0 0 24 24"><path d="M7 17L17 7M9 7h8v8"/></svg></span></div>
    </div>
