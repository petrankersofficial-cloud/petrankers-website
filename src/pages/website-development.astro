          </article>
        </div>
        <div class="pr-ix-prog" aria-hidden="true"><i data-ix-bar></i></div>
        <div class="pr-ix-nav"><button type="button" data-ix-prev aria-label="Previous"><svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"/></svg></button><button type="button" data-ix-next aria-label="Next"><svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg></button></div>
      </div>
    </div>
  </section>
  
  <section class="pr-sec pr-sec--navy pr-grain pr-orn pr-vsorn" id="web-pricing" aria-labelledby="wp-h">
    <svg class="pr-streaks" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><g fill="none" stroke="#FF6A00" stroke-linecap="round"><path d="M-80 640C260 460 520 700 860 480S1240 120 1560 240" stroke-opacity=".34" stroke-width="2"/><path d="M-80 720C280 540 540 780 880 560S1260 200 1560 320" stroke-opacity=".2" stroke-width="2"/><path d="M-80 560C240 380 500 620 840 400S1220 40 1560 160" stroke-opacity=".16" stroke-width="1.5"/></g></svg>
    <span class="pr-vsorn__rings" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="pr-vsorn__dots" aria-hidden="true"></span>
    <div class="pr-glow pr-glow--orange" style="width:640px;height:640px;left:-240px;top:-240px" aria-hidden="true"></div>
