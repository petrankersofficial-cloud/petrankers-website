      <span class="pr-ix-rings"><i></i><i></i><i></i></span>
    <div class="pr-badge-spin pr-badge-spin--sec pr-badge-spin--cream" aria-hidden="true"><svg viewBox="0 0 120 120" class="pr-badge-spin__ring"><defs><path id="pr-sc3" d="M60 60m-45 0a45 45 0 1 1 90 0a45 45 0 1 1-90 0"/></defs><circle cx="60" cy="60" r="60" fill="#0F1B33"/><text fill="#fff" font-size="9.5" font-weight="600"><textPath href="#pr-sc3" textLength="280" lengthAdjust="spacing">WEB DESIGN ✱ DEVELOPMENT ✱ FREE DESIGN ✱ </textPath></text></svg><span class="pr-badge-spin__core"><svg viewBox="0 0 24 24"><path d="M7 17L17 7M9 7h8v8"/></svg></span></div>
    </div>
    <div class="pr-wrap">
      <div class="pr-head">
        <span class="pr-eyebrow" data-reveal>Industries we serve</span>
        <h2 class="pr-h2" id="ind-h" data-reveal style="--d:1">Websites for every <em class="hl">pet business</em></h2>
        <p class="pr-lead" data-reveal style="--d:2">Each business type books clients differently. We design your pages, services and calls to action around how your customers choose and book.</p>
      </div>
      <div class="pr-ix" data-ix>
        <div class="pr-ix-track" data-ix-track tabindex="0" aria-label="Industries">
          <article class="pr-ix-card pr-ix-card--a" data-reveal style="--d:0">
