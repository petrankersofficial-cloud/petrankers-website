---
import BaseLayout from '../layouts/BaseLayout.astro';
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact Pet Rankers | Book a Free SEO Call",
    "url": "https://petrankers.com/contact/",
    "description": "Book a free call with Pet Rankers. Pick a time that suits you and talk to the team about local SEO and AI visibility for your pet business.",
    "mainEntity": {
      "@type": "Organization",
      "name": "Pet Rankers",
      "url": "https://petrankers.com/",
      "email": "seo@petrankers.com",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "email": "seo@petrankers.com",
        "url": "https://wa.me/+8801568566313"
      }
    }
  }
];
---

<BaseLayout
  metaTitle={"Contact Pet Rankers | Book a Free SEO Call"}
  exactTitle
  metaDescription={"Book a free call with Pet Rankers. Pick a time that suits you and talk to the team about local SEO and AI visibility for your pet business."}
  canonical={"https://petrankers.com/contact/"}
  ogImage={"https://petrankers.com/images/pet-business-seo-agency-google-maps-bookings.webp"}
  schema={schemas}
>
  <section class="pr-sec pr-hero pr-grain pr-shero pr-chero pr-arch-hero" aria-labelledby="hero-h">
    <svg class="pr-streaks" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><g fill="none" stroke="#fff" stroke-linecap="round"><path d="M-80 700C260 520 520 760 860 520S1240 120 1560 220" stroke-opacity=".22" stroke-width="2"/><path d="M-80 760C280 590 540 820 880 590S1260 190 1560 290" stroke-opacity=".14" stroke-width="2"/><path d="M-80 640C240 450 500 700 840 450S1220 50 1560 150" stroke-opacity=".12" stroke-width="1.5"/><path d="M700 -40C820 160 1060 120 1180 340S1300 700 1500 760" stroke-opacity=".18" stroke-width="2"/></g></svg>
    <div class="pr-glow pr-glow--light" style="width:720px;height:720px;right:-120px;top:-160px" aria-hidden="true"></div>
    <div class="pr-glow pr-glow--deep" style="width:640px;height:640px;left:-260px;bottom:-260px;animation-delay:-9s" aria-hidden="true"></div>
    <div class="pr-wrap pr-hero__grid">
      <div class="pr-hero__copy" style="gap:18px">
        <span class="pr-arch-kicker" data-reveal style="--d:1">Free 30-minute call</span>
        <h1 class="pr-h1" id="hero-h" data-reveal style="--d:1">Let’s get your pet business <span class="pr-mark">found first</span></h1>
        <p class="pr-lead" data-reveal style="--d:2">Pick a time below. We’ll look at how you show up on Google Maps and AI search, and tell you what we’d fix first.</p>
      </div>
    </div>
  </section>
  
  <section class="pr-sec pr-sec--cream pr-orn2 pr-arch pr-contact" aria-labelledby="book-h">
    <svg class="pr-orn2__lines" viewBox="0 0 1440 700" preserveAspectRatio="none" aria-hidden="true"><g fill="none" stroke="#FF6A00" stroke-linecap="round"><path d="M-80 560C260 380 520 620 860 400S1240 40 1560 160" stroke-opacity=".28" stroke-width="2"/><path d="M-80 640C280 460 540 700 880 480S1260 120 1560 240" stroke-opacity=".16" stroke-width="2"/><path d="M-80 480C240 300 500 540 840 320S1220 -40 1560 80" stroke-opacity=".12" stroke-width="1.5"/></g></svg>
    <span class="pr-orn2__dots" aria-hidden="true"></span>
    <div class="pr-wrap pr-arch__in pr-contact__in">
      <aside class="pr-contact__side" data-reveal>
        <div class="pr-contact__card pr-contact__alt">
          <h2 class="pr-h3">Prefer to message?</h2>
          <a class="pr-contact__link" href="mailto:seo@petrankers.com"><span class="pr-contact__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M4 7l8 6 8-6"/></svg></span><span><small>Email</small>seo@petrankers.com</span></a>
          <a class="pr-contact__link" href="https://wa.me/+8801568566313" target="_blank" rel="noopener"><span class="pr-contact__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 20l1.3-4A8 8 0 1 1 8 18.7z"/></svg></span><span><small>WhatsApp</small>Chat with us</span></a>
        </div>
      </aside>
      <div class="pr-contact__book" id="book" data-reveal style="--d:1">
        <div class="pr-contact__bookhd"><span class="pr-contact__live" aria-hidden="true"></span><h2 class="pr-h3" id="book-h">Book your call</h2><small>Times shown in your timezone</small></div>
        <div class="pr-contact__frame">
          <!-- Google Calendar Appointment Scheduling begin -->
          <iframe src="https://calendar.google.com/calendar/appointments/schedules/AcZssZ20PMYyJsUmEyPWIRK90WjS03zL-ftck8qSbk63LpYnk3jxe7wTRqfk873i5YLLHX1nqxdnobZQ?gv=true" title="Book a call with Pet Rankers" loading="lazy" style="border:0" width="100%" height="600" frameborder="0"></iframe>
          <!-- end Google Calendar Appointment Scheduling -->
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
