---
import BaseLayout from '../layouts/BaseLayout.astro';
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "name": "Pet Rankers, Author at Pet Rankers",
    "url": "https://petrankers.com/author-petrankers/",
    "description": "Articles from the Pet Rankers team.",
    "isPartOf": {
      "@type": "WebSite",
      "name": "Pet Rankers",
      "url": "https://petrankers.com/"
    },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://petrankers.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Pet Rankers",
          "item": "https://petrankers.com/author-petrankers/"
        }
      ]
    },
    "mainEntity": {
      "@type": "Organization",
      "name": "Pet Rankers"
    }
  }
];
---

<BaseLayout
  metaTitle={"Pet Rankers, Author at Pet Rankers"}
  exactTitle
  metaDescription={"Articles from the Pet Rankers team."}
  canonical={"https://petrankers.com/author-petrankers/"}
  ogImage={"https://petrankers.com/images/pet-business-seo-agency-google-maps-bookings.webp"}
  ogType={"profile"}
  noindex
  schema={schemas}
>
  <section class="pr-sec pr-hero pr-grain pr-shero pr-chero pr-arch-hero" aria-labelledby="hero-h">
    <svg class="pr-streaks" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><g fill="none" stroke="#fff" stroke-linecap="round"><path d="M-80 700C260 520 520 760 860 520S1240 120 1560 220" stroke-opacity=".22" stroke-width="2"/><path d="M-80 760C280 590 540 820 880 590S1260 190 1560 290" stroke-opacity=".14" stroke-width="2"/><path d="M-80 640C240 450 500 700 840 450S1220 50 1560 150" stroke-opacity=".12" stroke-width="1.5"/><path d="M700 -40C820 160 1060 120 1180 340S1300 700 1500 760" stroke-opacity=".18" stroke-width="2"/></g></svg>
    <div class="pr-glow pr-glow--light" style="width:720px;height:720px;right:-120px;top:-160px" aria-hidden="true"></div>
    <div class="pr-glow pr-glow--deep" style="width:640px;height:640px;left:-260px;bottom:-260px;animation-delay:-9s" aria-hidden="true"></div>
    <div class="pr-wrap pr-hero__grid">
      <div class="pr-hero__copy" style="gap:18px">
        <nav class="pr-crumbs" aria-label="Breadcrumb" data-reveal><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Pet Rankers</span></nav>
        <img class="pr-arch-av" data-reveal width="192" height="192" src="/images/cropped-Pet-Rankers-Icon-270x270.png" alt="Pet Rankers">
        <span class="pr-arch-kicker" data-reveal style="--d:1">Author</span>
        <h1 class="pr-h1" id="hero-h" data-reveal style="--d:1">Pet Rankers</h1>
        <p class="pr-lead" data-reveal style="--d:2">Articles from the Pet Rankers team.</p>
      </div>
    </div>
  </section>
  
  <section class="pr-sec pr-sec--cream pr-orn2 pr-arch" aria-label="Articles">
    <svg class="pr-orn2__lines" viewBox="0 0 1440 700" preserveAspectRatio="none" aria-hidden="true"><g fill="none" stroke="#FF6A00" stroke-linecap="round"><path d="M-80 560C260 380 520 620 860 400S1240 40 1560 160" stroke-opacity=".28" stroke-width="2"/><path d="M-80 640C280 460 540 700 880 480S1260 120 1560 240" stroke-opacity=".16" stroke-width="2"/><path d="M-80 480C240 300 500 540 840 320S1220 -40 1560 80" stroke-opacity=".12" stroke-width="1.5"/></g></svg>
    <span class="pr-orn2__dots" aria-hidden="true"></span>
    <div class="pr-wrap pr-arch__in">
      <div class="pr-arch__bar" data-reveal><span class="pr-arch__count"><b>0</b>articles</span></div>
      <div class="pr-arch__grid">
        <div class="pr-arch__empty" data-reveal><span class="pr-arch-kicker" style="background:var(--pr-orange-soft);border-color:transparent;color:var(--pr-orange-ink)">Coming soon</span><h2 class="pr-h3">No articles from Pet Rankers yet</h2><p>New guides on local SEO and AI visibility for pet businesses are on the way. In the meantime, read our latest article.</p><a class="pr-btn pr-btn--primary" href="/how-to-create-effective-client-reports-with-brightlocal/">Read the latest article<span class="pr-btn__arr" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 12h12M13 7l5 5-5 5"/></svg></span></a></div>
      </div>
    </div>
  </section>
  
  <section class="pr-sec pr-sec--navy pr-grain pr-orn pr-legal-cta" aria-labelledby="pcta-h">
    <svg class="pr-streaks" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><g fill="none" stroke="#FF6A00" stroke-linecap="round"><path d="M-80 640C260 460 520 700 860 480S1240 120 1560 240" stroke-opacity=".34" stroke-width="2"/><path d="M-80 720C280 540 540 780 880 560S1260 200 1560 320" stroke-opacity=".2" stroke-width="2"/><path d="M-80 560C240 380 500 620 840 400S1220 40 1560 160" stroke-opacity=".16" stroke-width="1.5"/></g></svg>
    <div class="pr-glow pr-glow--orange" style="width:560px;height:560px;left:50%;top:50%;margin:-280px 0 0 -280px;opacity:.45" aria-hidden="true"></div>
    <div class="pr-wrap pr-legal-cta__in">
      <h2 class="pr-h2" id="pcta-h" data-reveal>Get ahead on <em class="hl">AI visibility</em></h2>
      <p class="pr-lead" data-reveal style="--d:1">We’re already building AI visibility for pet groomers. Your competitors almost certainly aren’t. This is your window to get ahead.</p>
      <div class="pr-actions" data-reveal style="--d:2"><a class="pr-btn pr-btn--primary" href="/contact/">Schedule a Call<span class="pr-btn__arr" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 12h12M13 7l5 5-5 5"/></svg></span></a></div>
    </div>
  </section>
</BaseLayout>
