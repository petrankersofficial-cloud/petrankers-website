---
/**
 * TERMS OF USE TEMPLATE. Generic starting point built from site.config.ts.
 * Not legal advice: have the client review it before launch.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
const b = site.business;
---

<BaseLayout metaTitle="Terms of Use" metaDescription={`The terms that apply when you use the ${site.name} website, including content, estimates, and limits of liability.`}>
  <article class="container page-hero">
    <div class="prose">
      <h1>Terms of Use</h1>
      <p class="muted">Effective date: {site.legal.effectiveDate}</p>

      <p>By using {site.url} you agree to these terms. If you do not agree, please do not use the website.</p>

      <h2>Website content</h2>
      <p>Articles and guides on this website are general information, not professional advice for your specific situation. Prices and ranges are estimates and can change. A written quote from {site.name} is the only binding price.</p>

      <h2>Intellectual property</h2>
      <p>Text, images, logos, and design on this website belong to {b.legalName} or are used with permission. You may not copy or reuse them without written permission.</p>

      <h2>Third-party links</h2>
      <p>We link to other websites for reference. We are not responsible for their content or practices.</p>

      <h2>Limitation of liability</h2>
      <p>The website is provided "as is". To the extent allowed by law, {b.legalName} is not liable for damages that result from using the website or relying on its content.</p>

      <h2>Governing law</h2>
      <p>These terms are governed by the laws of {site.legal.jurisdiction}.</p>

      <h2>Contact</h2>
      <p>{b.legalName} · {b.phone} · <a href={`mailto:${b.email}`}>{b.email}</a></p>
    </div>
  </article>
</BaseLayout>
