---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  metaTitle={"About Pet Rankers | Specialist Pet Business SEO Team"}
  exactTitle
  metaDescription={"Meet the specialist team behind Pet Rankers. We work only with pet businesses, building local SEO strategies that turn Google rankings into real bookings."}
  canonical={"https://petrankers.com/about-us/"}
  ogImage={"https://petrankers.com/images/pet-business-seo-agency-google-maps-bookings.webp"}
  ogImageAlt={"Pet Rankers, the SEO agency for pet businesses, with a phone showing a \"dog groomer near me\" Google Maps search."}
>
  <section class="pr-sec pr-hero pr-grain pr-shero pr-chero" aria-labelledby="hero-h">
    <svg class="pr-streaks" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><g fill="none" stroke="#fff" stroke-linecap="round"><path d="M-80 700C260 520 520 760 860 520S1240 120 1560 220" stroke-opacity=".22" stroke-width="2"/><path d="M-80 760C280 590 540 820 880 590S1260 190 1560 290" stroke-opacity=".14" stroke-width="2"/><path d="M-80 640C240 450 500 700 840 450S1220 50 1560 150" stroke-opacity=".12" stroke-width="1.5"/><path d="M700 -40C820 160 1060 120 1180 340S1300 700 1500 760" stroke-opacity=".18" stroke-width="2"/></g></svg>
    <div class="pr-glow pr-glow--light" style="width:720px;height:720px;right:-120px;top:-160px" aria-hidden="true"></div>
    <div class="pr-glow pr-glow--deep" style="width:640px;height:640px;left:-260px;bottom:-260px;animation-delay:-9s" aria-hidden="true"></div>
    <div class="pr-wrap pr-hero__grid">
      <div class="pr-hero__copy">
        <div class="pr-shero__chips" data-reveal><span>Only for pet groomers</span><span>About us</span></div>
        <h1 class="pr-h1" id="hero-h" data-reveal style="--d:1">We built Pet Rankers because <span class="pr-mark">pet businesses</span> deserve better</h1>
        <p class="pr-lead" data-reveal style="--d:2">We are not a generic agency that stumbled into pet care. We chose this niche because it deserves specialists. People who eat, sleep, and breathe pet business SEO every single day.</p>
        <div class="pr-actions" data-reveal style="--d:3"><a class="pr-btn pr-btn--navy" href="/contact/">Schedule An Intro Call<span class="pr-btn__arr" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 12h12M13 7l5 5-5 5"/></svg></span></a><a class="pr-btn pr-btn--outline" href="#team">Meet the team</a></div>
      </div>
    
    </div>
  </section>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><symbol id="pr-ast" viewBox="0 0 24 24"><path d="M12 2v20M3.3 7l17.4 10M3.3 17L20.7 7" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round"/></symbol></svg>
  <div class="pr-ribbon-wrap" aria-label="Who we serve">
    <div class="pr-ribbon">
      <div class="pr-ribbon__track">
        <ul class="pr-ribbon__set"><li>PET GROOMERS<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>DOG TRAINERS<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>PET SITTERS<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>VETERINARY CLINICS<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>PET BOARDING<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>DOGGY DAYCARE<svg class="pr-ast"><use href="#pr-ast"/></svg></li></ul>
        <ul class="pr-ribbon__set" aria-hidden="true"><li>PET GROOMERS<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>DOG TRAINERS<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>PET SITTERS<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>VETERINARY CLINICS<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>PET BOARDING<svg class="pr-ast"><use href="#pr-ast"/></svg></li><li>DOGGY DAYCARE<svg class="pr-ast"><use href="#pr-ast"/></svg></li></ul>
      </div>
    </div>
  </div>
  
  <section class="pr-logos pr-sec--white" aria-labelledby="logos-h">
    <div class="pr-glow pr-glow--soft" style="width:520px;height:320px;left:50%;top:-80px;margin-left:-260px" aria-hidden="true"></div>
    <div class="pr-wrap">
      <h2 id="logos-h" data-reveal><span>Featured &amp; Trusted By</span></h2>
      <div class="pr-logos__row">
        <div class="pr-ltile" data-reveal style="--d:0"><img loading="lazy" width="1000" height="277" src="/images/Yahoo.svg" alt="Yahoo"></div>
        <div class="pr-ltile" data-reveal style="--d:1"><img loading="lazy" width="295" height="42" src="/images/Fast-Company.svg" alt="Fast Company"></div>
        <div class="pr-ltile" data-reveal style="--d:2"><img loading="lazy" width="1365" height="120" src="/images/Business-Insider.svg" alt="Business Insider"></div>
        <div class="pr-ltile" data-reveal style="--d:3"><img loading="lazy" width="125" height="25" src="/images/Wired.svg" alt="Wired"></div>
        <div class="pr-ltile" data-reveal style="--d:4"><img loading="lazy" width="258" height="48" src="/images/Bloomberg.svg" alt="Bloomberg"></div>
      </div>
    </div>
  </section>
  
  <section class="pr-sec pr-sec--cream pr-orn2" aria-labelledby="why-h">
    <svg class="pr-orn2__lines" viewBox="0 0 1440 700" preserveAspectRatio="none" aria-hidden="true"><g fill="none" stroke="#FF6A00" stroke-linecap="round"><path d="M-80 560C260 380 520 620 860 400S1240 40 1560 160" stroke-opacity=".28" stroke-width="2"/><path d="M-80 640C280 460 540 700 880 480S1260 120 1560 240" stroke-opacity=".16" stroke-width="2"/><path d="M-80 480C240 300 500 540 840 320S1220 -40 1560 80" stroke-opacity=".12" stroke-width="1.5"/></g></svg>
    <span class="pr-orn2__dots" aria-hidden="true"></span>
    <div class="pr-glow pr-glow--soft" style="width:520px;height:520px;right:-200px;top:-200px" aria-hidden="true"></div>
    <div class="pr-wrap pr-story">
      <div class="pr-story__head">
        <span class="pr-eyebrow" data-reveal>Core services</span>
        <h2 class="pr-h2" id="why-h" data-reveal style="--d:1">Why we went <em class="hl">all in</em> on pet businesses</h2>
        <p class="pr-lead" data-reveal style="--d:2">Most agencies take any client they can get. We made the opposite choice: go deep on one industry, become the best at it, and deliver what no generalist can match.</p>
      </div>
      <div class="pr-story__body">
        <article class="pr-story__card" data-reveal><span class="pr-story__n">01</span><p>We watched pet businesses, talented people who genuinely love their animals, struggle to get found online while weaker competitors ranked above them. That was the exact moment Pet Rankers was born.</p></article>
        <article class="pr-story__card" data-reveal style="--d:1"><span class="pr-story__n">02</span><p>Pet care is a relationship business built on local trust. Our SEO reflects that: community focused, intent driven, and built for real bookings, not the vanity metrics nobody books from.</p></article>
        <blockquote class="pr-story__quote" data-reveal style="--d:2"><span class="pr-story__qm" aria-hidden="true">“</span><p>We love the pet industry and the people who run these businesses. That is the whole reason this agency exists.</p><footer><img loading="lazy" width="80" height="80" src="/images/Hasibur-Joy-SEO-1-160.webp" alt=""><span><b>Hasibur Joy</b><small>Founder, Pet Rankers</small></span></footer></blockquote>
      </div>
    </div>
  </section>
  
  <section class="pr-sec pr-sec--navy pr-grain pr-orn pr-vsorn" aria-labelledby="dom-h">
    <svg class="pr-streaks" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><g fill="none" stroke="#FF6A00" stroke-linecap="round"><path d="M-80 640C260 460 520 700 860 480S1240 120 1560 240" stroke-opacity=".34" stroke-width="2"/><path d="M-80 720C280 540 540 780 880 560S1260 200 1560 320" stroke-opacity=".2" stroke-width="2"/><path d="M-80 560C240 380 500 620 840 400S1220 40 1560 160" stroke-opacity=".16" stroke-width="1.5"/></g></svg>
    <span class="pr-vsorn__rings" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="pr-vsorn__dots" aria-hidden="true"></span>
    <div class="pr-glow pr-glow--orange" style="width:620px;height:620px;left:-240px;top:-240px" aria-hidden="true"></div>
    <div class="pr-glow pr-glow--orange" style="width:540px;height:540px;right:-200px;bottom:-220px;animation-delay:-8s" aria-hidden="true"></div>
    <div class="pr-wrap">
      <div class="pr-head pr-head--center">
        <span class="pr-eyebrow" data-reveal>Our services</span>
        <h2 class="pr-h2" id="dom-h" data-reveal style="--d:1">Everything you need to <em class="hl">dominate</em> local search</h2>
        <p class="pr-lead" data-reveal style="--d:2">Eight services, one industry, all working together to build unbeatable local visibility for your pet business.</p>
      </div>
      <div class="pr-aeo">
        <article class="pr-aeo__card pr-pil" data-reveal data-spot style="--d:0"><span class="pr-aeo__ghost" aria-hidden="true">01</span><span class="pr-s8__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span><h3 class="pr-h3">Get found first</h3><p>We put your business in front of pet owners actively searching in your area. Google Maps, local search, and AI answers, all of it covered.</p></article>
        <article class="pr-aeo__card pr-pil" data-reveal data-spot style="--d:1"><span class="pr-aeo__ghost" aria-hidden="true">02</span><span class="pr-s8__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4M8 15l2.5 2.5L16 13"/></svg></span><h3 class="pr-h3">Fill your calendar</h3><p>Rankings mean nothing without bookings. Every strategy we build is designed around one outcome only: more real appointments sitting on your calendar each week.</p></article>
        <article class="pr-aeo__card pr-pil" data-reveal data-spot style="--d:2"><span class="pr-aeo__ghost" aria-hidden="true">03</span><span class="pr-s8__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/></svg></span><h3 class="pr-h3">Build long-term growth</h3><p>We do not chase quick wins that disappear in three months. Instead we build sustainable local authority that keeps compounding quietly over the years.</p></article>
      </div>
      <dl class="pr-stats">
        <div data-reveal><dt>Average lead increase</dt><dd>3x</dd></div>
        <div data-reveal style="--d:1"><dt>Avg. time to rank</dt><dd>90d</dd></div>
        <div data-reveal style="--d:2"><dt>Pet niche only</dt><dd>100%</dd></div>
        <div data-reveal style="--d:3"><dt>Groomers ranked</dt><dd>50+</dd></div>
      </dl>
    </div>
  </section>
  
  <section class="pr-sec pr-sec--cream pr-proc" aria-labelledby="proc-h">
    <svg class="pr-orn2__lines" viewBox="0 0 1440 700" preserveAspectRatio="none" aria-hidden="true"><g fill="none" stroke="#FF6A00" stroke-linecap="round"><path d="M-80 120C280 300 520 40 880 260S1240 520 1560 420" stroke-opacity=".22" stroke-width="2"/><path d="M-80 60C300 250 540 -10 900 200S1260 460 1560 360" stroke-opacity=".12" stroke-width="2"/></g></svg>
    <div class="pr-wrap">
      <div class="pr-head pr-head--center">
        <span class="pr-pilltag" data-reveal><i></i>How it works</span>
        <h2 class="pr-h2" id="proc-h" data-reveal style="--d:1">Simple process. <em class="hl">Real results.</em></h2>
        <p class="pr-lead" data-reveal style="--d:2">No jargon. No waiting game. Here’s exactly how we go from your first contact to a fully ranked grooming business.</p>
      </div>
      <ol class="pr-tl">
        <li class="pr-tl__step" data-reveal><span class="pr-tl__dot"><b>01</b></span><div class="pr-tl__card"><span class="pr-tl__ghost" aria-hidden="true">01</span><h3>We audit your Google presence</h3><p>Your Google profile, website, rankings, AI visibility, and three closest competitors. Written up and back to you in 48 hours.</p></div></li>
        <li class="pr-tl__step" data-reveal style="--d:1"><span class="pr-tl__dot"><b>02</b></span><div class="pr-tl__card"><span class="pr-tl__ghost" aria-hidden="true">02</span><h3>We build your 90-day ranking plan</h3><p>The audit becomes a 90-day plan. Which keywords, which areas, which fixes first. Nothing starts until you have approved it.</p></div></li>
        <li class="pr-tl__step" data-reveal style="--d:2"><span class="pr-tl__dot"><b>03</b></span><div class="pr-tl__card"><span class="pr-tl__ghost" aria-hidden="true">03</span><h3>We execute, and your bookings grow</h3><p>We handle rankings, content, posts, citations, and fixes. First business day of each month, you get a full written report.</p></div></li>
      </ol>
      <div class="pr-proc__shot" data-reveal>
        <span class="pr-proc__ring r1" aria-hidden="true"></span><span class="pr-proc__ring r2" aria-hidden="true"></span>
        <img loading="lazy" src="/images/Clients-Revenew-Graph.webp" srcset="/images/Clients-Revenew-Graph-640.webp 640w, /images/Clients-Revenew-Graph.webp 1200w" sizes="(max-width:860px) 92vw, 600px" width="1200" height="1100" srcset="/images/Clients-Revenew-Graph.webp 1200w, /images/Clients-Revenew-Graph-300x275.webp 300w, /images/Clients-Revenew-Graph-1024x939.webp 1024w, /images/Clients-Revenew-Graph-768x704.webp 768w" sizes="(max-width:640px) 100vw, 560px" alt="Phone screen showing a pet business ranking on Google Maps with rising search click growth">
      </div>
    </div>
  </section>
  
  <section class="pr-sec pr-sec--white pr-orn2" id="team" aria-labelledby="team-h">
    <svg class="pr-orn2__lines" viewBox="0 0 1440 700" preserveAspectRatio="none" aria-hidden="true"><g fill="none" stroke="#FF6A00" stroke-linecap="round"><path d="M-80 560C260 380 520 620 860 400S1240 40 1560 160" stroke-opacity=".28" stroke-width="2"/><path d="M-80 640C280 460 540 700 880 480S1260 120 1560 240" stroke-opacity=".16" stroke-width="2"/><path d="M-80 480C240 300 500 540 840 320S1220 -40 1560 80" stroke-opacity=".12" stroke-width="1.5"/></g></svg>
    <div class="pr-glow pr-glow--soft" style="width:520px;height:520px;left:-220px;bottom:-200px" aria-hidden="true"></div>
    <div class="pr-wrap">
      <div class="pr-head pr-head--center">
        <span class="pr-eyebrow" data-reveal>The team</span>
        <h2 class="pr-h2" id="team-h" data-reveal style="--d:1">The people behind <em class="hl">your rankings</em></h2>
      </div>
      <div class="pr-team">
        <article class="pr-tm" data-reveal style="--d:0">
          <div class="pr-tm__ph"><img loading="lazy" width="768" height="704" src="/images/Hasibur-Joy-SEO-1-768.webp" alt="Hasibur Joy SEO"></div>
          <div class="pr-tm__body"><h3 class="pr-tm__n">Hasibur Joy</h3><span class="pr-tm__r">Founder &amp; Director of Content Strategy</span><p>8 years in content strategy and local SEO. Built Pet Rankers to give grooming businesses the specialist attention generic agencies never could.</p>
          <div class="pr-tm__soc"><a href="https://www.linkedin.com/in/hasibur-rahman-joy/" target="_blank" rel="noopener" aria-label="Hasibur Joy on LinkedIn"><svg class="ic-li" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/></svg></a><a href="https://hasiburjoy.com/" target="_blank" rel="noopener" aria-label="Hasibur Joy portfolio"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg></a></div></div>
        </article>
        <article class="pr-tm" data-reveal style="--d:1">
          <div class="pr-tm__ph"><img loading="lazy" width="768" height="704" src="/images/Orrnob-Mahmud-768x704.webp" alt="Orrnob Mahmud"></div>
          <div class="pr-tm__body"><h3 class="pr-tm__n">Orrnob Mahmud</h3><span class="pr-tm__r">Lead SEO Strategist</span><p>A decade of local SEO experience. Handles the technical ranking work that puts pet businesses at the top of Google Maps and local search.</p>
          <div class="pr-tm__soc"><a href="https://www.linkedin.com/in/orrnobmahmud/" target="_blank" rel="noopener" aria-label="Orrnob Mahmud on LinkedIn"><svg class="ic-li" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/></svg></a><a href="https://orrnobmahmud.online/" target="_blank" rel="noopener" aria-label="Orrnob Mahmud portfolio"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg></a></div></div>
        </article>
        <article class="pr-tm" data-reveal style="--d:2">
          <div class="pr-tm__ph"><img loading="lazy" width="768" height="704" src="/images/Niyem-Islam-768x704.webp" alt="Niyem Islam"></div>
          <div class="pr-tm__body"><h3 class="pr-tm__n">Niyem Islam</h3><span class="pr-tm__r">SEO Executive</span><p>Executes the on-page and local SEO strategies that move pet businesses up the rankings. Detail-focused and grooming-niche trained from day one.</p>
          <div class="pr-tm__soc"><a href="https://www.linkedin.com/in/niyem-islam-bb350326b/" target="_blank" rel="noopener" aria-label="Niyem Islam on LinkedIn"><svg class="ic-li" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/></svg></a></div></div>
        </article>
        <article class="pr-tm" data-reveal style="--d:0">
          <div class="pr-tm__ph"><img loading="lazy" width="768" height="704" src="/images/Rashed-Ahmed-768x704.webp" alt="Rashed Ahmed, Content Executive at Pet Rankers, headshot photo"></div>
          <div class="pr-tm__body"><h3 class="pr-tm__n">Rashed Ahmed</h3><span class="pr-tm__r">Content Executive</span><p>Writes and optimizes the service pages, location pages, and blog content that earns rankings and converts pet owners into booked appointments.</p>
          <div class="pr-tm__soc"><a href="https://www.linkedin.com/in/mirza-mosabbir-rashed-826841214/" target="_blank" rel="noopener" aria-label="Rashed Ahmed on LinkedIn"><svg class="ic-li" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/></svg></a></div></div>
        </article>
        <article class="pr-tm" data-reveal style="--d:1">
          <div class="pr-tm__ph"><img loading="lazy" width="768" height="704" src="/images/Nafiul-Islam-768x704.webp" alt="Nafiul Islam"></div>
          <div class="pr-tm__body"><h3 class="pr-tm__n">Nafiul Islam</h3><span class="pr-tm__r">Web Developer</span><p>Builds and maintains the fast, mobile-first websites that make SEO work. Handles technical fixes, site structure, and booking system integrations.</p>
          <div class="pr-tm__soc"><a href="https://www.linkedin.com/in/nafiul01/" target="_blank" rel="noopener" aria-label="Nafiul Islam on LinkedIn"><svg class="ic-li" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/></svg></a></div></div>
        </article>
      </div>
    </div>
  </section>
  
  <section class="pr-sec pr-audit" aria-labelledby="audit-h">
    <span class="pr-audit__glow" aria-hidden="true"></span>
    <span class="pr-audit__grid" aria-hidden="true"></span>
    <div class="pr-wrap">
      <div class="pr-audit__frame" data-reveal>
        <span class="pr-audit__arc" aria-hidden="true"></span>
        <div class="pr-audit__team" aria-label="Your audit is done by our team">
          <img loading="lazy" width="80" height="80" src="/images/Hasibur-Joy-SEO-1-160.webp" alt="Hasibur Joy">
          <img loading="lazy" width="80" height="80" src="/images/Orrnob-Mahmud-avatar-160.webp" alt="Orrnob Mahmud">
          <span>Done by real people</span>
        </div>
        <h2 class="pr-audit__h" id="audit-h">
          <span class="pr-audit__tag">Get <b>FREE</b><svg class="pr-audit__cur" viewBox="0 0 40 40" aria-hidden="true"><path d="M4 4l32 12-14 4-4 14z"/></svg></span>
          <span class="pr-audit__big">SEO <em>Audit</em></span>
        </h2>
        <p class="pr-audit__p">We send you a real audit instead, free, inside 48 hours.</p>
        <a class="pr-audit__btn" href="/contact/">Find My SEO <em>Gaps</em><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg></a>
        <ul class="pr-audit__pts"><li>Google rankings</li><li>Business Profile</li><li>AI search visibility</li></ul>
      </div>
    </div>
  </section>
</BaseLayout>
