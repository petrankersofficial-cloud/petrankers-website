---
// © Pet Rankers. Ported verbatim from the live site (_legacy/) into the content system.
const path = Astro.url.pathname;
const cur = (p: string) => (path === p ? 'page' : undefined);
const servicesOn = path === '/seo-services/' || path === '/website-development/';
const contactHref = path === '/contact/' ? '#book' : '/contact/';
---
<nav class="pr-dock" id="pr-dock" aria-label="Quick navigation">
  <a class="pr-dock__home" href="/">Home</a>
  <div class="pr-dock__dd"><button class={servicesOn ? 'pr-dock__btn is-on' : 'pr-dock__btn'} type="button" aria-expanded="false" aria-controls="pr-dock-menu">Services<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button><div class="pr-dock__menu" id="pr-dock-menu"><a href="/seo-services/" aria-current={cur('/seo-services/')}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg>SEO Services</a><a href="/website-development/" aria-current={cur('/website-development/')}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/></svg>Website Development</a></div></div>
  <a class="pr-dock__cta" href={contactHref}>Schedule a Call<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg></a>
  <div class="pr-dock__dd pr-dock__dd--r"><button class="pr-dock__btn" type="button" aria-expanded="false" aria-controls="pr-dock-menu-2">Pricing<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button><div class="pr-dock__menu" id="pr-dock-menu-2"><a href="/seo-services/#what-we-do"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg>SEO Pricing</a><a href="/website-development/#web-pricing"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/></svg>Website Pricing</a></div></div>
  <a href="/about-us/" aria-current={cur('/about-us/')}>About Us</a>
</nav>
