---
// © Pet Rankers. Ported verbatim from the live site (_legacy/) into the content system.
const path = Astro.url.pathname;
const cur = (p: string) => (path === p ? 'page' : undefined);
const servicesOn = path === '/seo-services/' || path === '/website-development/';
const contactHref = path === '/contact/' ? '#book' : '/contact/';
---

<header class="pr-nav">
  <div class="pr-nav__bar">
    <a class="pr-nav__logo" href="/" aria-label="Pet Rankers home"><img src="/images/Petrankers.svg" width="119" height="34" alt="Petrankers - Seo agency for pet grommers"></a>
    <nav class="pr-nav__links" aria-label="Primary">
      <div class="pr-dd"><button class={servicesOn ? 'pr-dd__btn is-on' : 'pr-dd__btn'} type="button" aria-expanded="false" aria-haspopup="true">Services<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button><div class="pr-dd__menu"><a href="/seo-services/" aria-current={cur('/seo-services/')}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg>SEO Services</a><a href="/website-development/" aria-current={cur('/website-development/')}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/></svg>Website Development</a></div></div><div class="pr-dd"><button class="pr-dd__btn" type="button" aria-expanded="false" aria-haspopup="true">Pricing<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button><div class="pr-dd__menu"><a href="/seo-services/#what-we-do"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg>SEO Pricing</a><a href="/website-development/#web-pricing"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/></svg>Website Pricing</a></div></div><a href="/about-us/" aria-current={cur('/about-us/')}>About Us</a>
    </nav>
    <a class="pr-btn pr-btn--navy pr-btn--sm pr-nav__cta" href={contactHref}>Schedule a Call<span class="pr-btn__arr" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 12h12M13 7l5 5-5 5"/></svg></span></a>
    <button class="pr-nav__burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="pr-panel"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg></button>
  </div>
  <nav class="pr-nav__panel" id="pr-panel" aria-label="Mobile">
    <span class="pr-nav__grp">Services</span><a class="pr-nav__sub" href="/seo-services/" aria-current={cur('/seo-services/')}>SEO Services</a><a class="pr-nav__sub" href="/website-development/" aria-current={cur('/website-development/')}>Website Development</a><span class="pr-nav__grp">Pricing</span><a class="pr-nav__sub" href="/seo-services/#what-we-do">SEO Pricing</a><a class="pr-nav__sub" href="/website-development/#web-pricing">Website Pricing</a><a href="/about-us/" aria-current={cur('/about-us/')}>About Us</a>
    <a class="pr-btn pr-btn--navy" href={contactHref}>Schedule a Call<span class="pr-btn__arr" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 12h12M13 7l5 5-5 5"/></svg></span></a>
  </nav>
</header>
